rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Reusable Hardened Primitives ----
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFileId(id) {
      return id is string && id.size() >= 1 && id.size() <= 200 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Validation Blueprints ----
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'theme', 'lastSyncedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && (data.theme == 'light' || data.theme == 'dark')
        && (!('lastSyncedAt' in data) || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPickerBookmark(data) {
      return data.keys().hasAll(['ownerId', 'fileId', 'name', 'mimeType', 'webViewLink', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fileId', 'name', 'mimeType', 'webViewLink', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidFileId(data.fileId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 300
        && data.mimeType is string && data.mimeType.size() <= 160
        && data.webViewLink is string && data.webViewLink.size() <= 1000
        && (data.webViewLink.size() == 0 || data.webViewLink.matches('^https://.*$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---- Startup Connection Check Document ----
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ---- Admin Marker Collection (Read-only for self, server-managed) ----
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    // ---- Private User Sync Profiles ----
    match /userProfiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'lastSyncedAt', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // ---- Google Picker Bookmarks ----
    match /pickerBookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(bookmarkId)
        && isValidPickerBookmark(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(bookmarkId)
        && isValidPickerBookmark(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mimeType', 'webViewLink', 'updatedAt'])
        );
      allow delete: if isVerifiedUser()
        && isValidId(bookmarkId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
